# Qdrant Configuration (Required)
# For local development: http://localhost:6333
# For Qdrant Cloud: https://your-cluster.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333

# Qdrant API Key (Required for Qdrant Cloud, optional for local)
# Get this from your Qdrant Cloud dashboard
QDRANT_API_KEY=your_qdrant_api_key

# Collection Configuration
COLLECTION_NAME=kca_documents
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Configuration (Required - at least one)
GROQ_API_KEY=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
GOOGLE_API_KEY=your_google_api_key
CEREBRAS_API_KEY=your_cerebras_api_key  # Optional alternative

# Default LLM Provider: 'gemini' or 'cerebras'
DEFAULT_LLM=gemini

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# CORS Configuration (Optional - for production)
# Comma-separated list of allowed origins
# Example: https://kca-connect.netlify.app,https://app.yourdomain.com
ALLOWED_ORIGINS=*

